{
  "rewrites": [
    {
      "source": "/((?!api/|assets/|crypto-backtester-python.zip|favicon.svg).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/forecast-cron.js": {
      "maxDuration": 120
    },
    "api/chatter.js": {
      "maxDuration": 30
    },
    "api/picks.js": {
      "maxDuration": 300
    },
    "api/lab-cron.js": {
      "maxDuration": 120
    },
    "api/delisted.js": {
      "maxDuration": 300
    },
    "api/explorer-cron.js": {
      "maxDuration": 120
    },
    "api/daytrade-cron.js": {
      "maxDuration": 300
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ]
}