{
  "rewrites": [
    {
      "source": "/((?!api/|assets/|crypto-backtester-python.zip|favicon.svg).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/forecast-cron",
      "schedule": "20 0 * * *"
    }
  ],
  "functions": {
    "api/forecast-cron.js": {
      "maxDuration": 120
    },
    "api/chatter.js": {
      "maxDuration": 30
    }
  }
}