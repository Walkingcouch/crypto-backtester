{
  "rewrites": [
    {
      "source": "/((?!api/|assets/|crypto-backtester-python.zip|favicon.svg).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/forecast-cron.js": {
      "maxDuration": 300
    },
    "api/chatter.js": {
      "maxDuration": 30
    },
    "api/picks.js": {
      "maxDuration": 300
    },
    "api/lab-cron.js": {
      "maxDuration": 300
    },
    "api/delisted.js": {
      "maxDuration": 300
    },
    "api/explorer-cron.js": {
      "maxDuration": 300
    },
    "api/daytrade-cron.js": {
      "maxDuration": 800
    },
    "api/stocks-cron.js": {
      "maxDuration": 300
    },
    "api/stocks-explorer-cron.js": {
      "maxDuration": 300
    },
    "api/stocks-day-cron.js": {
      "maxDuration": 300
    },
    "api/signals-cron.js": {
      "maxDuration": 300
    },
    "api/smart-backtest-cron.js": {
      "maxDuration": 300
    },
    "api/exec-cron.js": {
      "maxDuration": 120
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/stocks-cron",
      "schedule": "30 6 * * 1-5"
    },
    {
      "path": "/api/stocks-cron",
      "schedule": "30 21 * * 1-5"
    },
    {
      "path": "/api/stocks-explorer-cron",
      "schedule": "40 6 * * 1-5"
    },
    {
      "path": "/api/stocks-explorer-cron",
      "schedule": "40 21 * * 1-5"
    },
    {
      "path": "/api/stocks-day-cron",
      "schedule": "5,35 23 * * 0-4"
    },
    {
      "path": "/api/stocks-day-cron",
      "schedule": "5,35 0-6 * * 1-5"
    },
    {
      "path": "/api/stocks-day-cron",
      "schedule": "5,35 13-21 * * 1-5"
    },
    {
      "path": "/api/signals-cron",
      "schedule": "10,40 * * * *"
    },
    {
      "path": "/api/smart-backtest-cron",
      "schedule": "20 19 * * *"
    },
    {
      "path": "/api/exec-cron",
      "schedule": "*/15 * * * *"
    }
  ]
}
